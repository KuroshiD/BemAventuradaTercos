{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "copy-assets": "cp -rf src/front dist/front",
    "build": "rm -rf ./dist; tsc && yarn copy-assets",
    "start": "node dist/server.js",
    "build-and-start": "yarn build && yarn start",
    "db:up": "docker-compose up -d db",
    "db:down": "docker-compose stop db",
    "migrate": "ts-node ./src/api/migrations/runMigrations.ts",
    "migrate:docker": "node scripts/migrate.js"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.1.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "multer": "^1.4.5-lts.1",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.18"
  }
}
